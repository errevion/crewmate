{
  "name": "crewmate",
  "version": "0.1.0",
  "description": "CLI-based workflow engine for contract-driven agent development",
  "type": "module",
  "bin": {
    "crewmate": "./dist/src/cli/index.js"
  },
  "exports": {
    ".": "./dist/src/cli/index.js",
    "./plugin": "./dist/src/adapters/opencode/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "cargo build --release --manifest-path crates/crewmate-watch/Cargo.toml",
    "watch": "tsc --watch",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "scan": "npm run scan:arch && npm run scan:dead-code",
    "scan:arch": "node ./dist/src/cli/index.js scan arch",
    "scan:dead-code": "node ./dist/src/cli/index.js scan dead-code",
    "test": "node scripts/run-tests.js",
    "test:src": "node --experimental-strip-types --test tests/**/*.test.ts"
  },
  "keywords": [
    "workflow",
    "engine",
    "contracts",
    "ai-agents",
    "opencode"
  ],
  "author": "Noiverre",
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "^2.0.16",
    "commander": "^15.0.0",
    "typescript": "^5.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.3"
  }
}
